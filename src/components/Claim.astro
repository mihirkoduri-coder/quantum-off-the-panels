---
// Neutral on purpose: not every issue is debunking a wrong claim, some
// just open on a quote worth sitting with. The label is plain attribution
// either way — "claims" presupposed it was always about to be wrong.
interface Props { source: string }
const { source } = Astro.props;
---
<blockquote class="claim">
  <span class="who" data-issue-key="post.claimSource">{source}</span>
  <span data-issue-key="post.claim"><slot /></span>
</blockquote>
