---
/**
 * THE CONCEPT MAP — hand-authored.
 *
 * ── HOW TO EDIT ────────────────────────────────────────────────────────────
 * Unpublished weeks do not get a node here at all — the map only ever shows
 * what a reader can actually open. To publish a week:
 *   1. add its <g class="node is-live"> at a position that reflects its real
 *      prereqs (see concepts.ts) — a week branches off whichever published
 *      node it actually builds on, it doesn't just queue up next in a row
 *   2. wrap it in <a href="/posts/week-NN-slug"> … </a>, text reads READ →
 *   3. draw a solid edge from each of its live prereqs into it (an elbow
 *      path, not a straight line, reads as a tree rather than a flowchart —
 *      see wk1→wk2 below), and re-add any callback edge that now has both
 *      ends published
 * Node size, position, and every path's coordinates are all literal — move
 * them freely as the tree grows and starts needing its own shape.
 *
 * ── EDGE PHILOSOPHY ────────────────────────────────────────────────────────
 * Solid elbow = a real prereq edge: this week actually builds on that one,
 * drawn as a branch off it rather than assumed from reading order. Dashed
 * arc = a callback: a week that reaches back to a non-adjacent one it
 * doesn't strictly require. There are only three callbacks, once every week
 * is live, and they are the three moments where the arc closes a loop. Do
 * NOT draw every prerequisite as a callback — the full dependency list
 * already lives in concepts.ts and renders as text on each post; this map
 * is for the shape of the tree, not a duplicate of that list. The three
 * callback paths (kept for reference, currently unused since their far end
 * isn't published yet — coordinates will need redoing against whatever the
 * tree looks like once they're live):
 *   wk2 interference → wk7 decoherence
 *   wk4 entanglement → wk11 two-qubit gates
 *   wk2 interference → wk12 Deutsch–Jozsa
 */
import { published, CONCEPTS } from "../data/concepts";
import { copy, format } from "../lib/site-copy";

// Arc 1 doesn't have a name field in concepts.ts (arcs are just numbers
// there — see `arc: number | null`), so this is hand-authored the same way
// the map's own node text is: a real string, not derived, because there's
// exactly one arc using this file today and giving it a generic naming
// system before a second arc exists would be solving a problem that
// doesn't exist yet.
const ARC_ONE_NAME = "Superposition Basics";

// scoped to arc 1 — issue 0 (arc 0) is the project's intro, not a physics
// concept, and doesn't belong on this grid. See concepts.ts for why.
const arc1 = CONCEPTS.filter((c) => c.arc === 1);
const live = published().filter((c) => c.arc === 1).sort((a, b) => (a.week ?? 0) - (b.week ?? 0));
const progressText = format(copy.conceptMap.progressTemplate, { count: live.length, total: arc1.length });
// was hardcoded to name week 1 specifically — a leak in its own right,
// since it kept claiming "starting with superposition" even while that
// week went back to a draft and the map had nothing published at all.
const mapLabel = live.length > 0
  ? `Concept map for arc one: ${progressText}, starting with ${live[0].title}.`
  : `Concept map for arc one: ${progressText}.`;
---

<figure class="map">
  <figcaption class="map__cap">
    <span class="eyebrow">
      <span class="wk" data-copy-key="labels.arc">{copy.labels.arc}</span>
      <span class="sep">/</span>
      <span
        data-copy-key="conceptMap.progressTemplate"
        data-copy-template="true"
        data-copy-raw={copy.conceptMap.progressTemplate}
        data-copy-vars={JSON.stringify({ count: live.length, total: arc1.length })}
      >{progressText}</span>
    </span>
    <h2 class="map__name">{ARC_ONE_NAME}</h2>
  </figcaption>

  <div class="map__scroll">
    <svg viewBox="-16 -16 422 372" class="map__svg" role="img" aria-label={mapLabel}>

      <defs>
        <marker id="tip" viewBox="0 0 8 8" refX="7" refY="4"
                markerWidth="5.5" markerHeight="5.5" orient="auto">
          <path d="M0,0 L8,4 L0,8 z" fill="var(--gutter)" />
        </marker>
        <marker id="tip-call" viewBox="0 0 8 8" refX="7" refY="4"
                markerWidth="5.5" markerHeight="5.5" orient="auto">
          <path d="M0,0 L8,4 L0,8 z" fill="var(--magenta)" />
        </marker>
      </defs>

      <!-- ═══ THE TREE ═══ week 2 actually requires week 1 (see concepts.ts
           prereqs), so it branches off week 1's bottom edge — an elbow, not
           a straight line, so it reads as "grows out of" rather than "comes
           after". ═══ -->
      <g class="spine">
        <path d="M110,130 L110,170 L280,170 L280,210" marker-end="url(#tip)" />
      </g>

      <!-- ═══ THE CALLBACKS ═══ nothing yet — see comment above for the three ═══ -->
      <g class="calls"></g>

      <!-- ═══ WEEK 1 ═══ published, the root of the tree so far ═══ -->
      <a href="/posts/week-01-superposition">
        <g class="node is-live">
          <rect x="0" y="0" width="220" height="130" rx="3" />
          <text class="n-wk"    x="16" y="28">ISSUE 01</text>
          <text class="n-title" x="16" y="62">Superposition</text>
          <text class="n-char"  x="16" y="90">Doctor Manhattan</text>
          <text class="n-state" x="16" y="114">READ →</text>
        </g>
      </a>

      <!-- ═══ WEEK 2 ═══ published, branches off week 1 above ═══ title's
           long enough to need a smaller size than week 1's got away with —
           first case of that, and the reason this is a per-node override
           rather than a shared rule. -->
      <a href="/posts/week-02-measurement-and-collapse">
        <g class="node is-live">
          <rect x="170" y="210" width="220" height="130" rx="3" />
          <text class="n-wk"    x="186" y="238">ISSUE 02</text>
          <text class="n-title" x="186" y="270" style="font-size:14px">Measurement &amp; Collapse</text>
          <text class="n-char"  x="186" y="300">Uatu the Watcher</text>
          <text class="n-state" x="186" y="324">READ →</text>
        </g>
      </a>

    </svg>
  </div>
</figure>

<style>
  .map { margin: 0; }
  .map__cap { margin-bottom: 1rem; }
  .map__name {
    font-family: var(--font-head); font-weight: 900; font-size: 1.5rem;
    margin: 0.3rem 0 0; letter-spacing: -0.01em;
  }
  .map__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .map__svg { width: 100%; max-width: 420px; height: auto; }

  .spine path, .spine line { stroke: var(--gutter); stroke-width: 2; fill: none; }
  .calls path {
    stroke: var(--magenta);
    stroke-width: 1.5;
    fill: none;
    stroke-dasharray: 4 5;
    opacity: 0.55;
  }

  .node rect {
    fill: var(--ink-2);
    stroke: var(--gutter);
    stroke-width: 2;
    stroke-dasharray: 5 4;
  }
  .node.is-live rect { stroke: var(--cyan); stroke-dasharray: 0; }

  .n-wk {
    font-family: var(--font-mono); font-size: 13px;
    letter-spacing: 0.12em; fill: var(--yellow);
  }
  .n-title {
    font-family: var(--font-head); font-weight: 900; font-size: 19px;
    fill: var(--paper); letter-spacing: -0.01em;
  }
  .n-char {
    font-family: var(--font-body); font-size: 16px;
    font-style: italic; fill: var(--paper-dim);
  }
  .n-state {
    font-family: var(--font-mono); font-size: 12px;
    letter-spacing: 0.14em; fill: var(--gutter);
  }
  .node.is-live .n-state { fill: var(--cyan); }

  .map__svg a { text-decoration: none; }
  .map__svg a:hover .node rect { fill: var(--ink-3); }
  .map__svg a:focus-visible { outline: 3px solid var(--yellow); outline-offset: 2px; }
</style>
