---
import { byId } from "../data/concepts";
interface Props { ids: string[] }
const { ids } = Astro.props;
const items = ids.map(byId).filter(Boolean);
---
{items.length > 0 && (
  <nav class="prereq" aria-label="Prerequisites">
    <span class="prereq__label">Builds on</span>
    <ul>
      {items.map((c) => (
        <li>
          {c!.published
            ? <a href={`/posts/${c!.slug}`}>Issue {c!.week} · {c!.title}</a>
            : <span class="dim">Issue {c!.week} · {c!.title} (not out yet)</span>}
        </li>
      ))}
    </ul>
  </nav>
)}
<style>
  .prereq {
    display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: baseline;
    border-left: 3px solid var(--yellow);
    padding: 0.5rem 0 0.5rem 0.85rem;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }
  .prereq__label {
    font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--yellow);
  }
  .prereq ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1rem; flex-wrap: wrap; }
</style>
