---
import Base from "../../layouts/Base.astro";
import Gallery from "../../components/Gallery";
import { copy, fullSiteTitle } from "../../lib/site-copy";
---
<Base title={`${copy.sims.heading} — ${fullSiteTitle()}`}>
  <div class="wrap">
    <h1>{copy.sims.heading}</h1>
    <p class="dim" style="max-width: 34rem">
      {copy.sims.intro}
    </p>
    <Gallery client:load />
  </div>
</Base>
