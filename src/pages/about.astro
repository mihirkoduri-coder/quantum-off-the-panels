---
import Base from "../layouts/Base.astro";
import { copy, fullSiteTitle } from "../lib/site-copy";
---
<Base title={`${copy.about.heading} — ${fullSiteTitle()}`}>
  <div class="wrap about">
    <h1 data-copy-key="about.heading">{copy.about.heading}</h1>

    <div class="about__body">
      <!-- burst frame: same halftone-fill + offset-shadow technique as the
           header's margin bursts (Base.astro) — a hard-edged magenta copy
           behind a cyan halftone-dot fill, just scaled to sit behind one
           photo instead of floating in a page margin.

           data-copy-key/data-copy-image live on the WHOLE frame, not just
           the inner box — the burst is the visually dominant part, so it
           has to be part of the click target too, or clicking the thing
           that actually looks clickable does nothing. data-copy-image-
           target marks which inner element admin-edit.js is allowed to
           clear and rebuild (the photo box), so uploading a photo can't
           ever wipe out the burst sitting next to it. -->
      <div class="about__photo-frame" data-copy-key="about.photoUrl" data-copy-image="true" data-copy-slug="about-photo">
        <svg class="about__burst" viewBox="-58 -58 116 116" aria-hidden="true">
          <defs>
            <pattern id="about-burst-dots" width="7" height="7" patternUnits="userSpaceOnUse">
              <circle cx="1" cy="1" r="1.2" fill="var(--cyan)" />
            </pattern>
          </defs>
          <polygon class="about__burst-shadow"
            points="0.0,-58.0 6.5,-22.1 31.4,-48.8 17.4,-15.1 52.8,-24.1 22.8,-3.3 57.4,8.3 20.9,9.6 43.8,38.0 12.4,19.3 16.3,55.7 0.0,23.0 -16.3,55.7 -12.4,19.3 -43.8,38.0 -20.9,9.6 -57.4,8.3 -22.8,-3.3 -52.8,-24.1 -17.4,-15.1 -31.4,-48.8 -6.5,-22.1"
            fill="var(--magenta)" transform="translate(5,5)" />
          <polygon
            points="0.0,-58.0 6.5,-22.1 31.4,-48.8 17.4,-15.1 52.8,-24.1 22.8,-3.3 57.4,8.3 20.9,9.6 43.8,38.0 12.4,19.3 16.3,55.7 0.0,23.0 -16.3,55.7 -12.4,19.3 -43.8,38.0 -20.9,9.6 -57.4,8.3 -22.8,-3.3 -52.8,-24.1 -17.4,-15.1 -31.4,-48.8 -6.5,-22.1"
            fill="url(#about-burst-dots)" stroke="var(--cyan)" stroke-width="2.5" stroke-linejoin="round" />
        </svg>

        <!-- the placeholder's own data-copy-key is nested inside the
             frame's data-copy-image — admin-edit.js resolves a click via
             closest(), innermost match first, so clicking this text
             specifically edits it as plain text; clicking anywhere else
             in the frame still triggers the photo upload. -->
        <div class="about__photo" data-copy-image-target="true">
          {copy.about.photoUrl
            ? <img src={copy.about.photoUrl} alt="" />
            : <span class="about__photo-placeholder" data-copy-key="about.photoPlaceholder">{copy.about.photoPlaceholder}</span>}
        </div>
      </div>

      <div class="prose about__bio">
        <p data-copy-key="about.bioP1">{copy.about.bioP1}</p>
        <p data-copy-key="about.bioP2">{copy.about.bioP2}</p>
      </div>
    </div>
  </div>

  <style>
    .about { padding: 2.5rem 0 5rem; }
    .about h1 { margin-bottom: 1.75rem; }

    .about__body { display: flex; flex-wrap: wrap; gap: 2.25rem; align-items: flex-start; }

    .about__photo-frame { position: relative; flex: 0 0 10rem; width: 10rem; height: 10rem; }
    html.qp-edit-mode .about__photo-frame:hover .about__burst { opacity: 1; }
    .about__burst {
      position: absolute; top: 50%; left: 50%; width: 17rem; height: 17rem;
      transform: translate(-50%, -50%) rotate(-6deg); opacity: 0.95; pointer-events: none;
    }
    .about__burst-shadow { opacity: 0.75; }

    .about__photo {
      position: relative; width: 10rem; height: 10rem;
      border: var(--panel-line) solid var(--gutter); border-radius: var(--radius);
      background: var(--ink-2); overflow: hidden;
      display: flex; align-items: center; justify-content: center;
    }
    .about__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .about__photo-placeholder {
      font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.04em;
      color: var(--paper-dim); text-align: center; padding: 1rem;
    }

    /* .prose normally centers itself (margin-inline: auto) for a post
       body reading top-to-bottom — here it sits beside the photo instead,
       so it hugs the left edge of its own space rather than centering in
       whatever's left of the row. No explicit flex-basis: that would
       override .prose's own width rule (flex-basis beats width when
       both apply), and that width — min(100% - 2.5rem, var(--measure))
       — is exactly what should still cap the reading column here. */
    .about__bio { margin-inline: 0; min-width: 16rem; }
  </style>
</Base>
