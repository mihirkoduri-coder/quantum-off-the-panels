---
import Base from "../layouts/Base.astro";
import ConceptMap from "../components/ConceptMap.astro";
import { CONCEPTS, published } from "../data/concepts";
import { copy, format, fullSiteTitle } from "../lib/site-copy";

// published implies grouped (see isGrouped() in concepts.ts) — the ?? 0
// never actually fires, it's just satisfying the type for concepts that
// technically could still be ungrouped drafts elsewhere in the manifest.
const live = published().sort((a, b) => (a.week ?? 0) - (b.week ?? 0));
const first = live[0];
const latest = live[live.length - 1];

// the "ARC 1" stat pairs with the concept map below it, so it's scoped to
// arc 1 the same way — issue 0 (arc 0) is the intro, not one of its weeks.
const arc1Live = live.filter((c) => c.arc === 1);
const arc1Total = CONCEPTS.filter((c) => c.arc === 1).length;

// issue 0 — the project's intro, arc 0, deliberately kept off the arc-1
// concept map (see ConceptMap.astro) since it isn't one of that arc's
// numbered weeks. Given its own section here instead, so it's still
// visible on the homepage rather than reachable only via a CTA button.
// Only ever renders if actually published, same rule as everything else.
const introConcepts = live.filter((c) => c.arc === 0);
---
<Base title={fullSiteTitle()}>
  <section class="hero wrap">
    <p class="eyebrow">
      <span class="wk" data-copy-key="labels.arc">{copy.labels.arc}</span><span class="sep">/</span>
      <!-- a {count}/{total} template — clicking it in edit mode shows the
           raw template (with the literal tokens) to edit, then re-renders
           the interpolated preview; see admin-edit.js. -->
      <span
        data-copy-key="homepage.progressTemplate"
        data-copy-template="true"
        data-copy-raw={copy.homepage.progressTemplate}
        data-copy-vars={JSON.stringify({ count: arc1Live.length, total: arc1Total })}
      >{format(copy.homepage.progressTemplate, { count: arc1Live.length, total: arc1Total })}</span>
    </p>
    <h1 class="hero__h">
      <span data-copy-key="homepage.headline">{copy.homepage.headline}</span><br />
      <span class="hero__em" data-copy-key="homepage.headlineAccent">{copy.homepage.headlineAccent}</span>
    </h1>
    <p class="hero__sub" data-copy-key="homepage.subhead">
      {copy.homepage.subhead}
    </p>
    {first && (
      <div class="hero__ctas">
        <a class="hero__cta btn btn--go" href={`/posts/${first.slug}`}>
          <span data-copy-key="homepage.ctaFirst">{copy.homepage.ctaFirst}</span>
        </a>
        {latest.slug !== first.slug && (
          <a class="hero__cta btn" href={`/posts/${latest.slug}`}>
            <span data-copy-key="homepage.ctaLatest">{copy.homepage.ctaLatest}</span>
          </a>
        )}
      </div>
    )}
  </section>

  {introConcepts.length > 0 && (
    <section class="wrap introsec">
      {introConcepts.map((c) => (
        <a class="intro-card dot-shadow" href={`/posts/${c.slug}`}>
          <span class="eyebrow">
            <span class="wk" data-copy-key="homepage.introLabel">{copy.homepage.introLabel}</span>
          </span>
          <h2 class="intro-card__h">{c.title}</h2>
          <p class="intro-card__b">{c.blurb}</p>
        </a>
      ))}
    </section>
  )}

  <section class="wrap mapsec">
    <ConceptMap />
  </section>

  <style>
    .hero { padding: 3rem 0 3.5rem; max-width: 52rem; }
    .hero__h { margin: 1rem 0; font-size: clamp(2.2rem, 7vw, 4.1rem); }
    .hero__em { color: var(--cyan); }
    .hero__sub { font-size: 1.15rem; max-width: 36rem; color: var(--paper); }
    .hero__ctas { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 1.5rem; }
    .hero__cta { display: inline-block; text-decoration: none; padding: 0.8rem 1.3rem; }

    .introsec { padding-bottom: 3rem; max-width: 30rem; }
    .intro-card {
      display: block; text-decoration: none;
      border: var(--panel-line) solid var(--gutter); border-radius: var(--radius);
      padding: 1.3rem 1.4rem; background: var(--ink-2);
    }
    .intro-card:hover { background: var(--ink-3); }
    .intro-card:hover .intro-card__h { color: var(--cyan); }
    .intro-card__h { margin: 0.5rem 0 0.4rem; font-size: 1.4rem; }
    .intro-card__b { margin: 0; color: var(--paper-dim); }

    .mapsec { padding-bottom: 4rem; }
  </style>
</Base>
