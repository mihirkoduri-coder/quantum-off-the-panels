---
import Base from "../layouts/Base.astro";
import { published } from "../data/concepts";
import { copy, fullSiteTitle } from "../lib/site-copy";

const live = published();
---
<Base title={`${copy.compendium.heading} — ${fullSiteTitle()}`}>
  <div class="wrap">
    <h1>{copy.compendium.heading}</h1>
    <p class="dim">{copy.compendium.intro}</p>

    <input id="q" class="search" type="search" placeholder={copy.compendium.searchPlaceholder} aria-label="Search" />

    <ul class="cards">
      {live.map((c) => (
        <li class="card dot-shadow" data-text={`${c.title} ${c.character}`.toLowerCase()}>
          <span class="eyebrow">
            <span class="wk">{copy.labels.issue} {String(c.week).padStart(2, "0")}</span>
            <span class="sep">/</span><span>{c.character}</span>
          </span>
          <h2 class="card__h"><a href={`/posts/${c.slug}`}>{c.title}</a></h2>
          <p class="card__b">{c.blurb}</p>
        </li>
      ))}
    </ul>
  </div>

  <script is:inline>
    const cards = [...document.querySelectorAll(".card")];
    document.getElementById("q").addEventListener("input", (e) => {
      const term = e.target.value.toLowerCase();
      cards.forEach((c) => { c.hidden = !!term && !c.dataset.text.includes(term); });
    });
  </script>

  <style>
    .search {
      width: 100%; max-width: 22rem; background: var(--ink-2); color: var(--paper);
      border: var(--panel-line) solid var(--gutter); border-radius: var(--radius);
      padding: 0.6rem 0.8rem; font-family: var(--font-body); font-size: 1rem; margin: 1.5rem 0 2rem;
    }
    .cards { list-style: none; padding: 0; display: grid; gap: var(--panel-gutter); grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); }
    .card { border: var(--panel-line) solid var(--gutter); border-radius: var(--radius); padding: 1.1rem; background: var(--ink-2); }
    .card__h { font-size: 1.2rem; margin: 0.5rem 0 0.4rem; }
    .card__h a { text-decoration: none; }
    .card__b { margin: 0; font-size: 0.95rem; color: var(--paper-dim); }
  </style>
</Base>
