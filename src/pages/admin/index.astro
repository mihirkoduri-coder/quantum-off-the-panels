---
export const prerender = false;
import Base from "../../layouts/Base.astro";
import { commitFile, getFileContent } from "../../lib/github";
import { CONCEPTS } from "../../data/concepts";
import {
  copy as defaultCopy,
  fullSiteTitle,
  LOGO_VARIANTS,
  PROCESS_COLORS,
  BACKSPLASH_OPTIONS,
  type SiteCopy,
} from "../../lib/site-copy";

// middleware.ts guarantees this is set before this page ever renders
const session = Astro.locals.session!;

const COPY_PATH = "src/data/site-copy.json";

let notice: string | null = Astro.url.searchParams.get("saved")
  ? "Saved. Vercel will redeploy in a minute or two."
  : null;
let error: string | null = null;

/** dot-path getter/setter — lets the form use flat names like "site.title"
 *  against the nested SiteCopy shape without hand-writing every field twice. */
function getPath(obj: any, path: string): any {
  return path.split(".").reduce((o, k) => o?.[k], obj);
}
function setPath(obj: any, path: string, value: unknown) {
  const keys = path.split(".");
  const last = keys.pop()!;
  const target = keys.reduce((o, k) => (o[k] ??= {}), obj);
  target[last] = value;
}

type Field =
  | { path: string; label: string; type?: "text" | "long"; hint?: string }
  | { path: string; label: string; type: "checkbox"; hint?: string }
  | { path: string; label: string; type: "select"; options: readonly string[]; hint?: string };

// every field the copy form edits, grouped for rendering. Keep this in
// sync with SiteCopy in lib/site-copy.ts — it's the one place both the
// form layout and the save logic read field names from.
const FIELDS: { group: string; fields: Field[] }[] = [
  {
    group: "Site identity (header, footer, browser tab, RSS)",
    fields: [
      { path: "site.title", label: "Title, plain part" },
      { path: "site.titleAccent", label: "Title, accent part (colored, e.g. \"Panels\")" },
      { path: "site.byline", label: "Byline" },
      { path: "site.description", label: "Description (browser/RSS metadata)", type: "long" },
      { path: "site.footerNote", label: "Footer note", type: "long" },
    ],
  },
  {
    group: "Logo (the header mark specifically)",
    fields: [
      { path: "site.logoVariant", label: "Which mark the header shows", type: "select", options: LOGO_VARIANTS },
      { path: "site.titleStyle.tilt", label: "Text logo: tilt", type: "checkbox", hint: "only applies when the mark above is \"text\"" },
      { path: "site.titleStyle.shadow", label: "Text logo: hard colored shadow", type: "checkbox" },
      { path: "site.titleStyle.shadowColor", label: "Shadow color", type: "select", options: PROCESS_COLORS },
      { path: "site.titleStyle.backsplash", label: "Backsplash behind the text", type: "select", options: BACKSPLASH_OPTIONS },
      { path: "site.titleStyle.backsplashColor", label: "Backsplash color", type: "select", options: PROCESS_COLORS },
    ],
  },
  {
    group: "Navigation",
    fields: [
      { path: "nav.compendium", label: "\"Compendium\" link" },
      { path: "nav.simulations", label: "\"Simulations\" link" },
      { path: "nav.rss", label: "\"RSS\" link" },
    ],
  },
  {
    group: "Shared labels (used in more than one place)",
    fields: [
      { path: "labels.issue", label: "The word for one issue/entry (e.g. \"Issue\")" },
      { path: "labels.arc", label: "Arc label (e.g. \"ARC 1\")" },
      { path: "labels.buildsOn", label: "Prerequisites label (e.g. \"Builds on\")" },
      { path: "labels.notOutYet", label: "Not-yet-published suffix" },
    ],
  },
  {
    group: "Homepage",
    fields: [
      { path: "homepage.headline", label: "Headline, plain part" },
      { path: "homepage.headlineAccent", label: "Headline, accent part (colored, own line)" },
      { path: "homepage.subhead", label: "Subhead paragraph", type: "long" },
      { path: "homepage.ctaFirst", label: "\"Start from the top\" button" },
      { path: "homepage.ctaLatest", label: "\"Latest issue\" button" },
      { path: "homepage.progressTemplate", label: "Progress stat", hint: "keep {count} and {total}" },
    ],
  },
  {
    group: "Concept map",
    fields: [
      { path: "conceptMap.progressTemplate", label: "Progress caption", hint: "keep {count} and {total}" },
    ],
  },
  {
    group: "Compendium page",
    fields: [
      { path: "compendium.heading", label: "Heading" },
      { path: "compendium.intro", label: "Intro paragraph", type: "long" },
      { path: "compendium.searchPlaceholder", label: "Search box placeholder" },
    ],
  },
  {
    group: "Simulations page + gallery",
    fields: [
      { path: "sims.heading", label: "Heading" },
      { path: "sims.intro", label: "Intro paragraph", type: "long" },
      { path: "sims.unlockedLabel", label: "\"unlocked on this device\"" },
      { path: "sims.resetButton", label: "Reset link" },
      { path: "sims.openButton", label: "Open button" },
      { path: "sims.lockedText", label: "Locked state text" },
      { path: "sims.notBuiltText", label: "Not-built-yet text" },
      { path: "sims.readPostLink", label: "\"Read the post\" link" },
    ],
  },
  {
    group: "Sim shell (wraps every sim)",
    fields: [
      { path: "simShell.eyebrowLabel", label: "Eyebrow label (e.g. \"SIM\")" },
      { path: "simShell.watchForLabel", label: "\"Watch for\" label" },
      { path: "simShell.resetButton", label: "Reset button" },
    ],
  },
  {
    group: "Predict (guess-before-you-touch-it ritual)",
    fields: [
      { path: "predict.eyebrowLabel", label: "Eyebrow label (e.g. \"PREDICT\")" },
      { path: "predict.beforeYouRunIt", label: "Eyebrow sub-text" },
      { path: "predict.lockItInButton", label: "Commit button" },
      { path: "predict.nailedIt", label: "Correct-guess sfx" },
      { path: "predict.nope", label: "Wrong-guess sfx" },
      { path: "predict.youSaidPrefix", label: "\"You said\" prefix" },
      { path: "predict.itsActuallyPrefix", label: "\"It's actually\" prefix" },
      { path: "predict.nudge", label: "Post-reveal nudge line" },
    ],
  },
  {
    group: "Violation explainer (forbidden-operation panel)",
    fields: [
      { path: "violationExplainer.youTriedToPrefix", label: "\"You tried to\" prefix" },
      { path: "violationExplainer.trySomethingElse", label: "Dismiss button" },
    ],
  },
];

let display: SiteCopy = defaultCopy;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const updated: any = JSON.parse(JSON.stringify(defaultCopy)); // structural clone, keeps any fields the form doesn't cover
  for (const { fields } of FIELDS) {
    for (const f of fields) {
      if (f.type === "checkbox") {
        setPath(updated, f.path, form.get(f.path) === "on");
      } else {
        setPath(updated, f.path, (form.get(f.path) as string | null) ?? "");
      }
    }
  }
  display = updated;

  try {
    const current = await getFileContent(session.accessToken, COPY_PATH);
    if (current === null) throw new Error("Could not read site-copy.json from the repo");
    await commitFile({
      accessToken: session.accessToken,
      path: COPY_PATH,
      content: `${JSON.stringify(updated, null, 2)}\n`,
      message: "admin: update site copy",
    });
    return Astro.redirect("/admin?saved=1#copy");
  } catch (err) {
    console.error(err);
    error = err instanceof Error ? err.message : "Something went wrong saving the copy.";
  }
} else {
  const current = await getFileContent(session.accessToken, COPY_PATH);
  if (current) {
    try {
      display = JSON.parse(current);
    } catch {
      error = "site-copy.json in the repo doesn't parse as JSON — showing the bundled defaults instead.";
    }
  }
}

// ---- issues list, grouped the same way /admin/issues used to ----
const ungrouped = CONCEPTS.filter((c) => c.week === null || c.arc === null);
const arcGroups = new Map<number, typeof CONCEPTS>();
for (const c of CONCEPTS) {
  if (c.arc === null) continue;
  if (!arcGroups.has(c.arc)) arcGroups.set(c.arc, []);
  arcGroups.get(c.arc)!.push(c);
}
const sortedArcs = [...arcGroups.entries()]
  .sort(([a], [b]) => a - b)
  .map(([arc, items]) => [arc, items.sort((a, b) => (a.week ?? 0) - (b.week ?? 0))] as const);
---
<Base title={`Admin — ${fullSiteTitle()}`}>
  <div class="wrap admin">
    <h1>Admin</h1>
    <p class="dim">Logged in as <b>{session.login}</b>. <a href="/api/auth/logout">Log out</a></p>

    {notice && <p class="admin__notice">{notice}</p>}
    {error && <p class="admin__error">Error: {error}</p>}

    <details id="issues" class="section" open>
      <summary><h2>Issues</h2></summary>
      <p class="dim">
        Writing something and grouping it into a reading order are separate
        steps — an issue can exist, get drafted, even get most of its content
        written, before you decide which arc it's in or what number it gets.
        Nothing has to slot into a pre-built roadmap. Editing an existing
        published issue's own text can also be done in place, right on its
        post page, once you're logged in — look for the floating Edit button.
      </p>

      {ungrouped.length > 0 && (
        <>
          <h3>Ungrouped</h3>
          <ul class="issue-list">
            {ungrouped.map((c) => (
              <li class="issue-row">
                <a href={`/admin/issues/${c.id}`}>
                  <span class="issue-row__wk">—</span>
                  <span class="issue-row__title">{c.title || c.id}</span>
                  <span class="issue-row__state">Not published</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}

      {sortedArcs.map(([arc, items]) => (
        <>
          <h3>Arc {arc}</h3>
          <ul class="issue-list">
            {items.map((c) => (
              <li class={`issue-row${c.published ? " is-live" : ""}`}>
                <a href={`/admin/issues/${c.id}`}>
                  <span class="issue-row__wk">{display.labels.issue} {String(c.week).padStart(2, "0")}</span>
                  <span class="issue-row__title">{c.title}</span>
                  <span class="issue-row__state">{c.published ? "Published" : "Not published"}</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      ))}

      <form action="/admin/issues/new-redirect" method="get" class="new-form">
        <label for="new-id">New issue id (lowercase, hyphenated, not on the list above)</label>
        <div class="row">
          <input id="new-id" name="id" type="text" pattern="[a-z0-9-]+" placeholder="e.g. quantum-teleportation" required />
          <button class="btn" type="submit">Create</button>
        </div>
      </form>
    </details>

    <details id="copy" class="section">
      <summary><h2>Site copy</h2></summary>
      <p class="dim">
        Every editable UI string and style toggle, grouped by where it shows
        up. Fields marked with a hint contain a <code>{"{placeholder}"}</code> —
        keep that token somewhere in the text, or the value it's supposed to
        carry won't appear. Most of this is also click-to-edit in place on
        the actual page once you're logged in — this form is the complete
        list, including the handful of fields (templates, the search
        placeholder) that in-place editing can't reach.
      </p>

      <form method="POST" class="copy-form">
        {FIELDS.map(({ group, fields }) => (
          <fieldset>
            <legend>{group}</legend>
            {fields.map((f) => (
              <label class={f.type === "checkbox" ? "is-checkbox" : ""}>
                {f.type === "checkbox" ? (
                  <>
                    <input type="checkbox" name={f.path} checked={Boolean(getPath(display, f.path))} />
                    {f.label} {f.hint && <span class="hint">({f.hint})</span>}
                  </>
                ) : f.type === "select" ? (
                  <>
                    {f.label} {f.hint && <span class="hint">({f.hint})</span>}
                    <select name={f.path}>
                      {f.options.map((opt) => (
                        <option value={opt} selected={getPath(display, f.path) === opt}>{opt}</option>
                      ))}
                    </select>
                  </>
                ) : f.type === "long" ? (
                  <>
                    {f.label} {f.hint && <span class="hint">({f.hint})</span>}
                    <textarea name={f.path} rows="3">{getPath(display, f.path) ?? ""}</textarea>
                  </>
                ) : (
                  <>
                    {f.label} {f.hint && <span class="hint">({f.hint})</span>}
                    <input type="text" name={f.path} value={getPath(display, f.path) ?? ""} />
                  </>
                )}
              </label>
            ))}
          </fieldset>
        ))}

        <button class="btn btn--go" type="submit">Save</button>
      </form>
    </details>
  </div>

  <script is:inline>
    // land on whichever section the URL hash points to, expanded — e.g.
    // after a copy save redirects back to /admin?saved=1#copy
    if (location.hash) {
      const el = document.querySelector(location.hash);
      if (el && el.tagName === "DETAILS") el.open = true;
    }
  </script>

  <style>
    .admin { padding: 2.5rem 0 5rem; max-width: 42rem; }
    .admin__notice { border-left: 2px solid var(--cyan); padding-left: 0.9rem; color: var(--paper); }
    .admin__error { border-left: 2px solid var(--magenta); padding-left: 0.9rem; color: var(--magenta); }

    .section { border: var(--panel-line) solid var(--gutter); border-radius: var(--radius); margin: 1.5rem 0; padding: 0 1.2rem; }
    .section summary { padding: 1rem 0; cursor: pointer; list-style: none; }
    .section summary::-webkit-details-marker { display: none; }
    .section summary h2 { display: inline; margin: 0; font-size: 1.1rem; }
    .section summary::before { content: "▸ "; color: var(--paper-dim); }
    .section[open] summary::before { content: "▾ "; }
    .section[open] { padding-bottom: 1.2rem; }
    .admin h3 { font-size: 1rem; margin: 1.5rem 0 0.5rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--paper-dim); }

    .issue-list { list-style: none; padding: 0; margin: 0.5rem 0; display: grid; gap: 0.6rem; }
    .issue-row a {
      display: flex; justify-content: space-between; align-items: center; gap: 1rem;
      border: var(--panel-line) solid var(--gutter); border-radius: var(--radius);
      padding: 0.8rem 1rem; text-decoration: none; background: var(--ink-2);
    }
    .issue-row.is-live a { border-color: var(--cyan); }
    .issue-row__wk { font-family: var(--font-mono); font-size: 0.75rem; color: var(--paper-dim); }
    .issue-row__title { flex: 1; font-weight: 700; }
    .issue-row__state { font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; color: var(--paper-dim); }
    .issue-row.is-live .issue-row__state { color: var(--cyan); }
    .new-form { margin-top: 1.5rem; border-top: var(--panel-line) solid var(--gutter); padding-top: 1.2rem; }
    .new-form label { display: block; font-size: 0.85rem; color: var(--paper-dim); margin-bottom: 0.5rem; }
    .new-form .row { display: flex; gap: 0.6rem; }
    .new-form input {
      flex: 1; background: var(--ink-2); color: var(--paper); border: var(--panel-line) solid var(--gutter);
      border-radius: var(--radius); padding: 0.6rem 0.8rem; font-family: var(--font-mono);
    }

    fieldset { border: var(--panel-line) solid var(--gutter); border-radius: var(--radius); padding: 1.2rem; margin: 1.5rem 0; }
    legend { font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--paper-dim); padding: 0 0.4rem; }
    .copy-form label { display: block; margin: 0.9rem 0; font-size: 0.85rem; color: var(--paper-dim); }
    .copy-form label.is-checkbox { display: flex; align-items: center; gap: 0.5rem; }
    .copy-form label.is-checkbox input { width: auto; margin: 0; }
    .copy-form input[type="text"], .copy-form textarea, .copy-form select {
      display: block; width: 100%; margin-top: 0.35rem; background: var(--ink-2); color: var(--paper);
      border: var(--panel-line) solid var(--gutter); border-radius: var(--radius);
      padding: 0.55rem 0.7rem; font-family: var(--font-body); font-size: 0.95rem;
    }
    .hint { font-style: italic; }
    code { font-family: var(--font-mono); background: var(--ink-2); padding: 0.1rem 0.3rem; border-radius: 2px; }
  </style>
</Base>
