---
export const prerender = false;
import Base from "../../layouts/Base.astro";
import { CONCEPTS, allSims } from "../../data/concepts";
import { copy, fullSiteTitle } from "../../lib/site-copy";
import { listSims } from "../../sims/registry";

// every built sim, plus which concept(s) currently reference its slug —
// a sim can be built and sit here unused until it's inserted into a body,
// or listed on a concept but not yet dropped into that post's prose.
const sims = listSims();
const usedBy = allSims();

// middleware.ts guarantees this is set before this page ever renders
const session = Astro.locals.session!;

// ---- issues list, grouped by arc ----
const ungrouped = CONCEPTS.filter((c) => c.week === null || c.arc === null);
const arcGroups = new Map<number, typeof CONCEPTS>();
for (const c of CONCEPTS) {
  if (c.arc === null) continue;
  if (!arcGroups.has(c.arc)) arcGroups.set(c.arc, []);
  arcGroups.get(c.arc)!.push(c);
}
const sortedArcs = [...arcGroups.entries()]
  .sort(([a], [b]) => a - b)
  .map(([arc, items]) => [arc, items.sort((a, b) => (a.week ?? 0) - (b.week ?? 0))] as const);
---
<Base title={`Admin — ${fullSiteTitle()}`}>
  <div class="wrap admin">
    <h1>Admin</h1>
    <p class="dim">Logged in as <b>{session.login}</b>. <a href="/api/auth/logout">Log out</a></p>

    <p class="callout">
      Site copy, a post's own text, and the logo's style are all edited in
      place now — visit any page, click <b>✏️ Edit</b> (bottom-right), and
      click whatever you want to change. This page is only for what
      genuinely has no page yet to click on.
    </p>

    <details id="issues" class="section" open>
      <summary><h2>Issues</h2></summary>
      <p class="dim">
        Writing something and grouping it into a reading order are separate
        steps — an issue can exist, get drafted, even get most of its content
        written, before you decide which arc it's in or what number it gets.
        Nothing has to slot into a pre-built roadmap. An existing published
        issue's own title/character/quote/ruling are click-to-edit right on
        its post page — come here to create something new, or to change its
        week, arc, tier, prerequisites, or sims.
      </p>

      {ungrouped.length > 0 && (
        <>
          <h3>Ungrouped</h3>
          <ul class="issue-list">
            {ungrouped.map((c) => (
              <li class="issue-row">
                <a href={`/admin/issues/${c.id}`}>
                  <span class="issue-row__wk">—</span>
                  <span class="issue-row__title">{c.title || c.id}</span>
                  <span class="issue-row__state">Not published</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}

      {sortedArcs.map(([arc, items]) => (
        <>
          <h3>Arc {arc}</h3>
          <ul class="issue-list">
            {items.map((c) => (
              <li class={`issue-row${c.published ? " is-live" : ""}`}>
                <a href={`/admin/issues/${c.id}`}>
                  <span class="issue-row__wk">{copy.labels.issue} {String(c.week).padStart(2, "0")}</span>
                  <span class="issue-row__title">{c.title}</span>
                  <span class="issue-row__state">{c.published ? "Published" : "Not published"}</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      ))}

      <form action="/admin/issues/new-redirect" method="get" class="new-form">
        <label for="new-id">New issue id (lowercase, hyphenated, not on the list above)</label>
        <div class="row">
          <input id="new-id" name="id" type="text" pattern="[a-z0-9-]+" placeholder="e.g. quantum-teleportation" required />
          <button class="btn" type="submit">Create</button>
        </div>
      </form>
    </details>

    <details id="simulations" class="section" open>
      <summary><h2>Simulations</h2></summary>
      <p class="dim">
        A sim is still real code — build it wherever, then paste the finished
        file in here. Once it's saved it lives here independent of any post:
        drop its marker into a body's prose from an issue's own editor
        (there's a picker right above the body field), or paste the
        shortcode below directly. It becomes the real embed automatically
        when the issue saves — nothing about it looks like code while
        you're drafting.
      </p>

      {sims.length === 0 ? (
        <p class="dim">Nothing built yet.</p>
      ) : (
        <ul class="sim-list">
          {sims.map((s) => {
            const owners = usedBy.filter((u) => u.slug === s.slug).map((u) => u.concept);
            return (
              <li class="sim-row">
                <div class="sim-row__top">
                  <span class="sim-row__title">{s.title}</span>
                  <code class="sim-row__shortcode" data-shortcode={`[[sim:${s.slug}]]`}>{`[[sim:${s.slug}]]`}</code>
                  <button type="button" class="btn sim-copy" data-copy-target={`[[sim:${s.slug}]]`}>Copy</button>
                  <a class="btn" href={`/admin/sims/${s.slug}/preview`}>Preview</a>
                  <a class="btn" href={`/admin/sims/${s.slug}`}>Edit code</a>
                </div>
                <p class="sim-row__meta">
                  {owners.length > 0
                    ? <>Listed on: {owners.map((c) => <a href={`/admin/issues/${c.id}`}>{c.title || c.id}</a>).reduce((prev, cur) => <>{prev}, {cur}</>)}</>
                    : "Not listed on any issue yet"}
                </p>
              </li>
            );
          })}
        </ul>
      )}

      <form action="/admin/sims/new-redirect" method="get" class="new-form">
        <label for="new-sim-slug">New sim slug (lowercase, hyphenated, not on the list above)</label>
        <div class="row">
          <input id="new-sim-slug" name="slug" type="text" pattern="[a-z0-9-]+" placeholder="e.g. two-path-interference" required />
          <button class="btn" type="submit">Create</button>
        </div>
      </form>
    </details>
  </div>

  <script is:inline>
    document.querySelectorAll(".sim-copy").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const text = btn.dataset.copyTarget;
        try {
          await navigator.clipboard.writeText(text);
          const original = btn.textContent;
          btn.textContent = "Copied!";
          setTimeout(() => { btn.textContent = original; }, 1200);
        } catch {
          window.prompt("Copy this:", text);
        }
      });
    });
  </script>

  <style>
    .admin { padding: 2.5rem 0 5rem; max-width: 42rem; }
    .callout { border-left: 2px solid var(--cyan); padding-left: 0.9rem; color: var(--paper); margin: 1.5rem 0; }

    .section { border: var(--panel-line) solid var(--gutter); border-radius: var(--radius); margin: 1.5rem 0; padding: 0 1.2rem; }
    .section summary { padding: 1rem 0; cursor: pointer; list-style: none; }
    .section summary::-webkit-details-marker { display: none; }
    .section summary h2 { display: inline; margin: 0; font-size: 1.1rem; }
    .section summary::before { content: "▸ "; color: var(--paper-dim); }
    .section[open] summary::before { content: "▾ "; }
    .section[open] { padding-bottom: 1.2rem; }
    .admin h3 { font-size: 1rem; margin: 1.5rem 0 0.5rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--paper-dim); }

    .issue-list { list-style: none; padding: 0; margin: 0.5rem 0; display: grid; gap: 0.6rem; }
    .issue-row a {
      display: flex; justify-content: space-between; align-items: center; gap: 1rem;
      border: var(--panel-line) solid var(--gutter); border-radius: var(--radius);
      padding: 0.8rem 1rem; text-decoration: none; background: var(--ink-2);
    }
    .issue-row.is-live a { border-color: var(--cyan); }
    .issue-row__wk { font-family: var(--font-mono); font-size: 0.75rem; color: var(--paper-dim); }
    .issue-row__title { flex: 1; font-weight: 700; }
    .issue-row__state { font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; color: var(--paper-dim); }
    .issue-row.is-live .issue-row__state { color: var(--cyan); }
    .new-form { margin-top: 1.5rem; border-top: var(--panel-line) solid var(--gutter); padding-top: 1.2rem; }
    .new-form label { display: block; font-size: 0.85rem; color: var(--paper-dim); margin-bottom: 0.5rem; }
    .new-form .row { display: flex; gap: 0.6rem; }
    .new-form input {
      flex: 1; background: var(--ink-2); color: var(--paper); border: var(--panel-line) solid var(--gutter);
      border-radius: var(--radius); padding: 0.6rem 0.8rem; font-family: var(--font-mono);
    }

    .sim-list { list-style: none; padding: 0; margin: 0.5rem 0; display: grid; gap: 0.6rem; }
    .sim-row {
      border: var(--panel-line) solid var(--gutter); border-radius: var(--radius);
      padding: 0.8rem 1rem; background: var(--ink-2);
    }
    .sim-row__top { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem; }
    .sim-row__title { font-weight: 700; }
    .sim-row__shortcode { font-family: var(--font-mono); font-size: 0.8rem; color: var(--cyan); }
    .sim-copy { padding: 0.3rem 0.7rem; font-size: 0.75rem; margin-left: auto; }
    .sim-row__meta { margin: 0.5rem 0 0; font-size: 0.75rem; color: var(--paper-dim); }
    .sim-row__meta a { color: var(--paper-dim); }
  </style>
</Base>
