---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Prereqs from "../../components/Prereqs.astro";
import Claim from "../../components/Claim.astro";
import Verdict from "../../components/Verdict.astro";
import { byId, neighbours } from "../../data/concepts";

export async function getStaticPaths() {
  const posts = await getCollection("posts", (p) => !p.data.draft);
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const c = byId(post.data.conceptId)!;
const { prev, next } = neighbours(c.id);
---
<Base title={`${post.data.title} — Quantum off the Panels`} description={c.blurb}>
  <article>
    <header class="post__head">
      <!-- the cover: the one loud moment on the page. issue number, character,
           title. Chrome (prereqs, claim) stays below and stays quiet. -->
      <div class="cover dot-shadow">
        <div class="cover__badge">
          <span class="cover__badgeLabel">Issue</span>
          <span class="cover__badgeNum">{c.week !== null ? String(c.week).padStart(2, "0") : "—"}</span>
        </div>
        <p class="eyebrow cover__eyebrow">
          <span>{c.title}</span><span class="sep">/</span><span>{c.character}</span>
        </p>
        <h1 class="cover__title">{post.data.title}</h1>
        {post.data.subtitle && <p class="cover__sub">{post.data.subtitle}</p>}
      </div>

      <div class="prose post__chrome">
        <Prereqs ids={c.prereqs} />
        {post.data.claim && post.data.claimSource && (
          <Claim source={post.data.claimSource}>{post.data.claim}</Claim>
        )}
      </div>
    </header>

    <div class="prose post__body">
      <Content />
    </div>

    <div class="prose">
      {post.data.ruling && (
        <Verdict ruling={post.data.ruling}>
          <slot name="verdict" />
        </Verdict>
      )}

      <nav class="post__nav">
        {prev && prev.week !== null ? <a href={prev.published ? `/posts/${prev.slug}` : "/compendium"}>← Issue {prev.week}</a> : <span />}
        {next && next.week !== null && <a href={next.published ? `/posts/${next.slug}` : "/compendium"}>Issue {next.week} →</a>}
      </nav>
    </div>
  </article>

  <style>
    .post__head { padding-top: 1rem; }

    /* ---------- the cover ---------- */
    .cover {
      position: relative;
      width: min(100% - 2.5rem, 46rem);
      margin: 0 auto 2.2rem;
      padding: 2.3rem 1.75rem 1.85rem;
      background: var(--ink-2);
      border: 3px solid var(--gutter);
      border-radius: var(--radius);
    }
    .cover__badge {
      position: absolute;
      top: -16px;
      left: 1.6rem;
      display: flex;
      align-items: baseline;
      gap: 0.35rem;
      background: var(--ink);
      border: 3px solid var(--yellow);
      border-radius: var(--radius);
      padding: 0.3rem 0.65rem;
      transform: rotate(-3deg);
    }
    .cover__badgeLabel {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--yellow);
    }
    .cover__badgeNum {
      font-family: var(--font-head);
      font-weight: 900;
      font-size: 1.35rem;
      color: var(--paper);
      letter-spacing: -0.02em;
    }
    .cover__eyebrow { margin: 0.7rem 0 0.5rem; }
    /* a little of the badge's yellow carried into the title — restrained,
       one flat offset rather than the full inked-outline treatment .sfx
       uses, since this text is already big and bold enough to read fine
       on its own. */
    .cover__title { margin: 0 0 0.3rem; font-size: clamp(2rem, 5.4vw, 3.2rem); text-shadow: 3px 3px 0 var(--yellow); }
    .cover__sub { font-size: 1.15rem; color: var(--paper-dim); margin: 0; }

    /* ---------- the chrome: quiet, back in the calm measure ---------- */
    .post__chrome { margin-top: 1.4rem; }

    .post__body :global(h2) { margin-top: 2.6em; }
    /* sims break the measure — they get the full column */
    .post__body :global(.sim), .post__body :global(.pr__gate), .post__body :global(.pr__result) {
      width: min(100vw - 2.5rem, 60rem);
      margin-inline: calc(50% - min(50vw - 1.25rem, 30rem));
    }
    .post__nav { display: flex; justify-content: space-between; margin: 3rem 0; font-family: var(--font-mono); font-size: 0.8rem; }
  </style>
</Base>
