---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import { copy, fullSiteTitle } from "../lib/site-copy";

interface Props { title: string; description?: string }
const { title, description = copy.site.description } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon-final.svg" />
    <link rel="alternate" type="application/rss+xml" title={fullSiteTitle()} href="/rss.xml" />
    <meta name="theme-color" content="#0b0e1a" />
  </head>
  <body>
    <!-- margin bursts — purely decorative page furniture, wide viewports only.
         Coloured like the Predict reveal (.sfx / .sfx--break): a halftone
         fill in one process ink, a hard-edged offset copy in a second, the
         same two-colour "inked hit" the NAILED IT!/NOPE! text uses. Five
         shapes: three jagged stars (a/b/c) plus two curvier, scalloped
         ones (d/e, cubic-bezier lobes instead of straight points) so the
         set doesn't read as one repeated silhouette. -->
    <div class="bursts" aria-hidden="true">
      <svg class="burst burst--a" viewBox="-58 -58 116 116">
        <defs>
          <pattern id="burstDotsCyan" width="7" height="7" patternUnits="userSpaceOnUse">
            <circle cx="1" cy="1" r="1" fill="var(--cyan)" />
          </pattern>
        </defs>
        <polygon class="burst__shadow"
          points="0.0,-58.0 6.5,-22.1 31.4,-48.8 17.4,-15.1 52.8,-24.1 22.8,-3.3 57.4,8.3 20.9,9.6 43.8,38.0 12.4,19.3 16.3,55.7 0.0,23.0 -16.3,55.7 -12.4,19.3 -43.8,38.0 -20.9,9.6 -57.4,8.3 -22.8,-3.3 -52.8,-24.1 -17.4,-15.1 -31.4,-48.8 -6.5,-22.1"
          fill="var(--magenta)" transform="translate(5,5)" />
        <polygon
          points="0.0,-58.0 6.5,-22.1 31.4,-48.8 17.4,-15.1 52.8,-24.1 22.8,-3.3 57.4,8.3 20.9,9.6 43.8,38.0 12.4,19.3 16.3,55.7 0.0,23.0 -16.3,55.7 -12.4,19.3 -43.8,38.0 -20.9,9.6 -57.4,8.3 -22.8,-3.3 -52.8,-24.1 -17.4,-15.1 -31.4,-48.8 -6.5,-22.1"
          fill="url(#burstDotsCyan)" stroke="var(--cyan)" stroke-width="1.5" stroke-linejoin="round" />
      </svg>
      <svg class="burst burst--b" viewBox="-34 -34 68 68">
        <defs>
          <pattern id="burstDotsMagenta" width="7" height="7" patternUnits="userSpaceOnUse">
            <circle cx="1" cy="1" r="1" fill="var(--magenta)" />
          </pattern>
        </defs>
        <polygon class="burst__shadow"
          points="0.0,-34.0 4.4,-12.2 21.9,-26.0 11.3,-6.5 33.5,-5.9 12.8,2.3 29.4,17.0 8.4,10.0 11.6,31.9 0.0,13.0 -11.6,31.9 -8.4,10.0 -29.4,17.0 -12.8,2.3 -33.5,-5.9 -11.3,-6.5 -21.9,-26.0 -4.4,-12.2"
          fill="var(--cyan)" transform="translate(5,5)" />
        <polygon
          points="0.0,-34.0 4.4,-12.2 21.9,-26.0 11.3,-6.5 33.5,-5.9 12.8,2.3 29.4,17.0 8.4,10.0 11.6,31.9 0.0,13.0 -11.6,31.9 -8.4,10.0 -29.4,17.0 -12.8,2.3 -33.5,-5.9 -11.3,-6.5 -21.9,-26.0 -4.4,-12.2"
          fill="url(#burstDotsMagenta)" stroke="var(--magenta)" stroke-width="1.5" stroke-linejoin="round" />
      </svg>
      <svg class="burst burst--c" viewBox="-50 -50 100 100">
        <defs>
          <pattern id="burstDotsYellow" width="7" height="7" patternUnits="userSpaceOnUse">
            <circle cx="1" cy="1" r="1" fill="var(--yellow)" />
          </pattern>
        </defs>
        <polygon class="burst__shadow"
          points="0.0,-50.0 5.4,-12.9 35.4,-35.4 12.9,-5.4 50.0,0.0 12.9,5.4 35.4,35.4 5.4,12.9 0.0,50.0 -5.4,12.9 -35.4,35.4 -12.9,5.4 -50.0,0.0 -12.9,-5.4 -35.4,-35.4 -5.4,-12.9"
          fill="var(--magenta)" transform="translate(5,5)" />
        <polygon
          points="0.0,-50.0 5.4,-12.9 35.4,-35.4 12.9,-5.4 50.0,0.0 12.9,5.4 35.4,35.4 5.4,12.9 0.0,50.0 -5.4,12.9 -35.4,35.4 -12.9,5.4 -50.0,0.0 -12.9,-5.4 -35.4,-35.4 -5.4,-12.9"
          fill="url(#burstDotsYellow)" stroke="var(--yellow)" stroke-width="1.5" stroke-linejoin="round" />
      </svg>
      <!-- d: curvier, 7-lobe scalloped burst (cubic beziers, not straight points) -->
      <svg class="burst burst--d" viewBox="-44 -44 88 88">
        <defs>
          <pattern id="burstDotsCyan2" width="7" height="7" patternUnits="userSpaceOnUse">
            <circle cx="1" cy="1" r="1" fill="var(--cyan)" />
          </pattern>
        </defs>
        <path class="burst__shadow"
          d="M0.0,-24.0 C9.8,-38.8 24.2,-31.8 18.8,-15.0 C36.4,-16.5 40.0,-0.9 23.4,5.3 C35.6,18.2 25.6,30.7 10.4,21.6 C8.0,39.2 -8.0,39.2 -10.4,21.6 C-25.6,30.7 -35.6,18.2 -23.4,5.3 C-40.0,-0.9 -36.4,-16.5 -18.8,-15.0 C-24.2,-31.8 -9.8,-38.8 -0.0,-24.0 Z"
          fill="var(--yellow)" transform="translate(5,5)" />
        <path
          d="M0.0,-24.0 C9.8,-38.8 24.2,-31.8 18.8,-15.0 C36.4,-16.5 40.0,-0.9 23.4,5.3 C35.6,18.2 25.6,30.7 10.4,21.6 C8.0,39.2 -8.0,39.2 -10.4,21.6 C-25.6,30.7 -35.6,18.2 -23.4,5.3 C-40.0,-0.9 -36.4,-16.5 -18.8,-15.0 C-24.2,-31.8 -9.8,-38.8 -0.0,-24.0 Z"
          fill="url(#burstDotsCyan2)" stroke="var(--cyan)" stroke-width="1.5" stroke-linejoin="round" />
      </svg>
      <!-- e: curvier, 5-lobe scalloped burst — plumper, fewer/bigger lobes than d -->
      <svg class="burst burst--e" viewBox="-48 -48 96 96">
        <defs>
          <pattern id="burstDotsMagenta2" width="7" height="7" patternUnits="userSpaceOnUse">
            <circle cx="1" cy="1" r="1" fill="var(--magenta)" />
          </pattern>
        </defs>
        <path class="burst__shadow"
          d="M0.0,-17.0 C14.9,-41.4 34.8,-27.0 16.2,-5.3 C44.0,1.4 36.4,24.7 10.0,13.8 C12.3,42.3 -12.3,42.3 -10.0,13.8 C-36.4,24.7 -44.0,1.4 -16.2,-5.3 C-34.8,-27.0 -14.9,-41.4 -0.0,-17.0 Z"
          fill="var(--yellow)" transform="translate(5,5)" />
        <path
          d="M0.0,-17.0 C14.9,-41.4 34.8,-27.0 16.2,-5.3 C44.0,1.4 36.4,24.7 10.0,13.8 C12.3,42.3 -12.3,42.3 -10.0,13.8 C-36.4,24.7 -44.0,1.4 -16.2,-5.3 C-34.8,-27.0 -14.9,-41.4 -0.0,-17.0 Z"
          fill="url(#burstDotsMagenta2)" stroke="var(--magenta)" stroke-width="1.5" stroke-linejoin="round" />
      </svg>
      <!-- two decorative onomatopoeia, same treatment as the sim reveal's
           .sfx/.sfx--break. An intentional exception to "onomatopoeia only
           on real sim events" — this is ambient page furniture in the
           margins, same category as the bursts, not a claim that anything
           happened. -->
      <span class="sfx ambient-sfx ambient-sfx--a">POW!</span>
      <span class="sfx sfx--break ambient-sfx ambient-sfx--b">BAM!</span>
    </div>

    <header class="site">
      <div class="wrap site__in">
        <a href="/" class="site__mark">
          <!-- inlined (not <img src="/logo-final.svg">) specifically so its
               fills can be var(--x) instead of baked-in hex — the only way
               the mark re-colors itself when the light-mode toggle flips
               the same tokens the rest of the page already uses, rather
               than needing a second exported asset to keep in sync. -->
          <svg class="site__logo" viewBox="0 0 300 200" role="img" aria-label={fullSiteTitle()}>
            <defs>
              <!-- same single-dot-per-cell halftone the page background
                   uses (body's radial-gradient in global.css), same
                   gutter-token ink, just scaled up to this viewBox — so
                   the texture reads as the site's own ground showing
                   through the panel, not an unrelated pattern pasted in. -->
              <pattern id="qp-dots" width="14" height="14" patternUnits="userSpaceOnUse">
                <circle cx="3.5" cy="3.5" r="1.4" fill="var(--gutter)" />
              </pattern>
              <linearGradient id="qp-fade" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#fff" stop-opacity="1" />
                <stop offset="100%" stop-color="#fff" stop-opacity="0" />
              </linearGradient>
              <mask id="qp-fademask"><rect x="90" y="34" width="130" height="132" fill="url(#qp-fade)" /></mask>
              <clipPath id="qp-bodies">
                <rect x="90" y="34" width="52" height="104" />
                <rect x="160" y="62" width="60" height="104" />
              </clipPath>
              <linearGradient id="qp-gutter" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--magenta)" stop-opacity="1" />
                <stop offset="100%" stop-color="var(--magenta)" stop-opacity="0.15" />
              </linearGradient>
            </defs>

            <polygon points="90,34 142,34 142,138 90,138 58,86" fill="var(--ink-2)" />
            <polygon points="160,62 220,62 252,114 220,166 160,166" fill="var(--ink-2)" />

            <g clip-path="url(#qp-bodies)">
              <rect x="90" y="34" width="130" height="132" fill="url(#qp-dots)" opacity="0.3" mask="url(#qp-fademask)" />
            </g>

            <path d="M90 34 L142 34 L142 138 L90 138" fill="none" stroke="var(--gutter)" stroke-width="2" />
            <path d="M220 62 L160 62 L160 166 L220 166" fill="none" stroke="var(--gutter)" stroke-width="2" />

            <rect x="149" y="34" width="5" height="132" fill="url(#qp-gutter)" />

            <path d="M95.24 25.48 L58 86 L95.24 146.52" fill="none" stroke="var(--cyan)" stroke-width="12" stroke-linecap="butt" stroke-linejoin="miter" />
            <path d="M214.76 53.48 L252 114 L214.76 174.52" fill="none" stroke="var(--yellow)" stroke-width="12" stroke-linecap="butt" stroke-linejoin="miter" />

            <g>
              <path d="M445 -90H291Q255 -90 255 -54V1Q178 13 135.0 40.0Q92 67 75.0 107.5Q58 148 58 198V530Q58 576 72.0 613.5Q86 651 120.0 678.0Q154 705 214.5 720.0Q275 735 369 735Q463 735 523.5 720.0Q584 705 618.0 678.0Q652 651 665.5 613.5Q679 576 679 530V198Q679 148 662.0 107.5Q645 67 602.5 39.5Q560 12 481 1V-54Q481 -90 445 -90ZM285 220Q285 200 300.0 186.5Q315 173 369 173Q424 173 438.5 186.5Q453 200 453 220V493Q453 513 438.5 526.0Q424 539 369 539Q315 539 300.0 526.0Q285 513 285 493Z" transform="translate(87.816,113.040) scale(0.064000,-0.064000)" fill="var(--magenta)" opacity="0.85" />
              <path d="M445 -90H291Q255 -90 255 -54V1Q178 13 135.0 40.0Q92 67 75.0 107.5Q58 148 58 198V530Q58 576 72.0 613.5Q86 651 120.0 678.0Q154 705 214.5 720.0Q275 735 369 735Q463 735 523.5 720.0Q584 705 618.0 678.0Q652 651 665.5 613.5Q679 576 679 530V198Q679 148 662.0 107.5Q645 67 602.5 39.5Q560 12 481 1V-54Q481 -90 445 -90ZM285 220Q285 200 300.0 186.5Q315 173 369 173Q424 173 438.5 186.5Q453 200 453 220V493Q453 513 438.5 526.0Q424 539 369 539Q315 539 300.0 526.0Q285 513 285 493Z" transform="translate(83.816,109.040) scale(0.064000,-0.064000)" fill="var(--paper)" />
              <path d="M260 0H105Q69 0 69 36V684Q69 720 105 720H411Q502 720 553.5 695.5Q605 671 626.0 627.0Q647 583 647 525V397Q647 339 626.0 295.0Q605 251 553.5 226.5Q502 202 411 202H296V36Q296 0 260 0ZM294 533V382H384Q413 382 422.0 397.0Q431 412 431 431V484Q431 504 422.0 518.5Q413 533 384 533Z" transform="translate(179.412,142.480) scale(0.068000,-0.068000)" fill="var(--cyan)" opacity="0.85" />
              <path d="M260 0H105Q69 0 69 36V684Q69 720 105 720H411Q502 720 553.5 695.5Q605 671 626.0 627.0Q647 583 647 525V397Q647 339 626.0 295.0Q605 251 553.5 226.5Q502 202 411 202H296V36Q296 0 260 0ZM294 533V382H384Q413 382 422.0 397.0Q431 412 431 431V484Q431 504 422.0 518.5Q413 533 384 533Z" transform="translate(175.412,138.480) scale(0.068000,-0.068000)" fill="var(--paper)" />
            </g>

            <circle cx="136" cy="26" r="3.6" fill="var(--yellow)" />
            <circle cx="168" cy="174" r="3.6" fill="var(--yellow)" />
          </svg>
          <span class="site__by" data-copy-key="site.byline">{copy.site.byline}</span>
        </a>
        <nav class="site__nav">
          <a href="/compendium" data-copy-key="nav.compendium">{copy.nav.compendium}</a>
          <a href="/sims" data-copy-key="nav.simulations">{copy.nav.simulations}</a>
          <a href="/rss.xml" data-copy-key="nav.rss">{copy.nav.rss}</a>
          <button id="theme" class="site__theme" aria-label="Switch to light mode">◐</button>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-foot">
      <div class="wrap">
        <p class="dim" data-copy-key="site.footerNote">
          {copy.site.footerNote}
        </p>
        <p class="site-foot__by">{copy.site.title} <span class="site__accent">{copy.site.titleAccent}</span>, {copy.site.byline}</p>
      </div>
    </footer>

    <script is:inline>
      // set before paint to avoid a flash; dark is the default
      const saved = localStorage.getItem("qp:theme");
      if (saved) document.documentElement.dataset.theme = saved;
      document.getElementById("theme")?.addEventListener("click", () => {
        const el = document.documentElement;
        const next = el.dataset.theme === "light" ? "dark" : "light";
        el.dataset.theme = next;
        localStorage.setItem("qp:theme", next);
      });
    </script>

    <!-- no-op for regular visitors: checks a non-privileged cookie and
         does nothing further unless it's present. See public/admin-edit.js. -->
    <script is:inline src="/admin-edit.js" defer></script>

    <style>
      .site { border-bottom: var(--panel-line) solid var(--gutter); background: var(--ink); position: sticky; top: 0; z-index: 20; }
      .site__in { display: flex; justify-content: space-between; align-items: center; gap: 1rem 1.5rem; padding: 0.85rem 0; flex-wrap: wrap; }
      .site__mark {
        display: flex; flex-direction: column; gap: 0.15rem;
        text-decoration: none; line-height: 1.1;
      }
      .site__logo { height: 3.6rem; width: auto; display: block; }
      .site__accent { color: var(--yellow); }
      .site__by {
        font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.1em;
        text-transform: uppercase; color: var(--paper-dim);
      }
      .site__mark:hover .site__logo { opacity: 0.85; }
      .site__mark:hover { background: none; }
      .site__nav { display: flex; gap: 1.1rem; align-items: center; }
      .site__nav a {
        font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em;
        text-transform: uppercase; color: var(--paper-dim); text-decoration: none;
      }
      .site__nav a:hover { color: var(--cyan); background: none; }
      .site__theme {
        background: none; border: none; color: var(--paper-dim); cursor: pointer;
        font-size: 1rem; min-height: 44px; min-width: 44px;
      }
      .site-foot { border-top: var(--panel-line) solid var(--gutter); margin-top: 5rem; padding: 2rem 0 3rem; font-size: 0.85rem; }
      .site-foot__by {
        font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.1em;
        text-transform: uppercase; color: var(--paper-dim); margin: 0.6rem 0 0;
      }
      main { padding: 2.5rem 0 0; }

      /* margin bursts — decorative, wide viewports only. Each one is
         positioned by the same formula: (actual margin past .wrap's 68rem)
         minus a per-shape depth, staggered so they don't line up in a
         column. Rather than guess a pixel breakpoint where every shape is
         guaranteed to fit (which has been wrong twice now, in both
         directions), .bursts is a fixed full-viewport frame with
         overflow: hidden and the shapes are absolutely positioned inside
         it — so a shape that doesn't fit is simply clipped by the real
         viewport edge instead of vanishing outright or overlapping
         content. It self-corrects at any width; there's no number to
         re-tune. The media query below is only a cheap skip for phones/
         tablets, where there's never going to be margin to fill. */
      .bursts { position: fixed; inset: 0; overflow: hidden; pointer-events: none; display: none; }
      .burst { position: absolute; height: auto; opacity: 0.6; }
      .burst__shadow { opacity: 0.65; }
      .burst--a { top: 5rem; left: calc((100vw - 68rem) / 2 - 7.2rem); width: 6.2rem; transform: rotate(-6deg); }
      .burst--b { bottom: 5rem; right: calc((100vw - 68rem) / 2 - 5.8rem); width: 4.8rem; transform: rotate(11deg); }
      .burst--c { bottom: 9rem; left: calc((100vw - 68rem) / 2 - 7.3rem); width: 4.3rem; transform: rotate(-10deg); }
      .burst--d { top: 9rem; right: calc((100vw - 68rem) / 2 - 10.5rem); width: 5.5rem; transform: rotate(15deg); }
      /* off-centre on purpose, not a mechanical 50% — breaks up the column with a and c */
      .burst--e { top: 38%; left: calc((100vw - 68rem) / 2 - 10.3rem); width: 5.3rem; transform: translateY(-50%) rotate(6deg); }
      /* the two ambient onomatopoeia — position:absolute inside the same
         clipped frame the bursts use, so oversized text just gets clipped
         safely rather than needing an exact width estimate. */
      .ambient-sfx { position: absolute; opacity: 0.7; white-space: nowrap; }
      .ambient-sfx--a { top: 50%; right: calc((100vw - 68rem) / 2 - 3.5rem); transform: translateY(-50%) rotate(-8deg); }
      .ambient-sfx--b { top: 65%; left: calc((100vw - 68rem) / 2 - 3rem); transform: translateY(-50%) rotate(10deg); }
      @media (min-width: 60rem) {
        .bursts { display: block; }
      }
    </style>
  </body>
</html>
